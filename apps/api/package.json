{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch",
    "db:generate": "drizzle-kit generate && node scripts/sync-supabase-migrations.mjs",
    "db:migrate": "node scripts/supabase-db.mjs push",
    "db:migrate:dry": "node scripts/supabase-db.mjs push --dry-run",
    "db:push": "node -e \"console.error('drizzle-kit push는 이력 없이 DB를 바꿔서 쓰지 않습니다. supabase/README.md의 db:generate → db:migrate:dry → db:migrate를 쓰세요.'); process.exit(1)\"",
    "db:studio": "drizzle-kit studio",
    "db:sync": "node scripts/sync-supabase-migrations.mjs",
    "db:status": "node scripts/supabase-db.mjs status",
    "regions:build": "node scripts/build-regions.ts",
    "db:seed": "node scripts/seed-regions.ts",
    "db:seed:foods": "node scripts/seed-foods.ts",
    "foods:check": "node scripts/check-foods.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "drizzle-orm": "^1.0.0-rc.6",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "proj4": "^2.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/proj4": "^2.5.6",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^1.0.0-rc.6",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
