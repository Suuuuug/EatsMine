PORT=4000
# 웹 프론트 주소 (CORS 허용)
WEB_ORIGIN=http://localhost:3000
# Supabase → Project Settings → Database → Connection string
# 서버리스(Vercel)에서는 Transaction pooler(6543) 주소 권장
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# Supabase 프로젝트 주소 (Project Settings → API → Project URL) — 로그인 토큰 검증용
SUPABASE_URL=https://[project-ref].supabase.co
# 잇플 검색 API (선택, 기본값: k-skill 프록시)
EATPL_BASE_URL=https://k-skill-proxy.nomadamas.org
EATPL_TIMEOUT_MS=8000
