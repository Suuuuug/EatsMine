NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 개발 확인용 더미(영토 주인·순위·내 리뷰 수). 제출·배포 전 off 로 끈다.
# NEXT_PUBLIC_DUMMY_DATA=off

# Supabase Auth (Project Settings → API). 공개 가능한 publishable/anon 키만 쓴다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ 개발용 임시 테스트 로그인(next dev에서만, 오른쪽 아래 '테스트 로그인' 버튼).
# Supabase 대시보드 Authentication → Users에서 만든 이메일·비밀번호 테스트 계정. .env.local에만 두고 Vercel에는 넣지 않는다.
NEXT_PUBLIC_DEV_LOGIN_EMAIL=
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=
